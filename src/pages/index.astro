---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, postHref } from '../lib/format';

const posts = (await getCollection('posts')).filter(post => post.id !== 'experiencia-laboral.md').sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const laboralExperience = (await getCollection('posts')).filter(post => post.id === 'experiencia-laboral.md').sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

---

<BaseLayout title="Blog">

  <section class="intro">
    <h1>
      ¡Hola! 👋, Soy <strong>Rodrigo Poblete</strong> bienvenido a mi blog.
    </h1>
    <p>
      Acá podras encontrar en que me encuentro trabajando, 
      mi experiencia laboral y mis ultimos posts referentes a mis proyectos.
      puedes revisar mi cuenta de <a href="https://github.com/rodrigoDev0n">github</a>
    </p>
  </section>

  <section class="intro">
    <h1>
      Referente a mi trabajo y quien soy.
    </h1>
    <p>
      Acá puedes encontrar mi curriculum en formato blog.
    </p>
  </section>

  <ul class="post-list">
    {laboralExperience.map((post) => (
      <li class="post-card">
        <a class="post-card__link" href={postHref(post.id)}>
          <h2 class="post-card__title">{post.data.title}</h2>
          <p class="post-card__description">{post.data.description}</p>
        </a>
        <ul class="post-card__tags">
          {post.data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

  <section class="intro">
    <h1>Últimos posts</h1>
  </section>
  
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a class="post-card__link" href={postHref(post.id)}>
          <time class="post-card__date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <h2 class="post-card__title">{post.data.title}</h2>
          <p class="post-card__description">{post.data.description}</p>
        </a>
        <ul class="post-card__tags">
          {post.data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .intro h1 {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }
  .intro p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.5rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  .post-card__link {
    color: var(--text);
  }
  .post-card__link:hover {
    text-decoration: none;
  }

  .post-card__date {
    display: block;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .post-card__title {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .post-card__link:hover .post-card__title {
    color: var(--accent);
  }

  .post-card__description {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0.9rem 0 0;
    list-style: none;
  }
</style>
