---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate, slugFromId } from "../../lib/format";
import { siGithub } from "simple-icons";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: slugFromId(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const repos = post.data.repos ?? [];

const repoLabel = (url: string) => {
  const match = url.match(/github\.com\/([^/]+\/[^/]+)/);
  return match ? match[1] : url;
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post__header">
      <a class="post__back" href="/">← volver al blog</a>
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <span>{post.data.author}</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </p>
      <ul class="post__tags">
        {post.data.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
      {repos.length > 0 && (
        <div class="post__repos">
          <h2 class="post__repos-title">Repositorios relacionados al post</h2>
          <ul class="repo-list">
            {repos.map((url) => (
              <li class="repo_list__item">
                <a class="repo-card" href={url} target="_blank" rel="noopener noreferrer">
                  <span class="repo-card__icon" set:html={`<svg viewBox="0 0 24 24"><path d="${siGithub.path}"/></svg>`} />
                  <span class="repo-card__info">
                    <span class="repo-card__name">{repoLabel(url)}</span>
                    <span class="repo-card__hint">ver en github →</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </header>

    <div class="post__content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2rem 1.75rem;
  }

  .post__back {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.75rem;
  }

  .post__header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border);
  }

  .post__header h1 {
    font-size: 1.7rem;
    margin-bottom: 0.75rem;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .post__content :global(h2) {
    font-size: 1.35rem;
    margin: 2.25rem 0 0.75rem;
  }
  .post__content :global(h3) {
    font-size: 1.1rem;
    margin: 1.75rem 0 0.5rem;
  }
  .post__content :global(li)::marker {
    color: var(--accent);
  }
  .post__content :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1.5rem;
    font-size: 0.92rem;
  }
  .post__content :global(th),
  .post__content :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .post__content :global(th) {
    background: var(--code-bg);
    font-family: var(--mono);
    font-weight: 400;
  }

  .post__repos {
    margin-top: 1.5rem;
  }
  .post__repos-title {
    font-size: 0.85rem;
    font-family: var(--mono);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .repo-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .repo-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .repo-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .repo-card__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--text);
    padding: 5px;
  }
  .repo-card__icon svg {
    display: block;
    width: 16px;
    height: 16px;
    fill: var(--bg);
  }

  .repo-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .repo-card__name {
    font-family: var(--mono);
    font-size: 0.88rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .repo-card__hint {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .repo-card:hover .repo-card__hint {
    color: var(--accent);
  }
  .repo_list__item {
    padding: 0 0 0.5rem;
  }
</style>
